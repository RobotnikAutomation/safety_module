---
registers:
  - name: PWR_DRIVERS
    description:
      short: Enables the power stage of the drivers, allowing the robot to move.
      values:
        - "false": Power stage is disabled.
        - "true": Power stage is enabled.
    type: bool/v1
    kind: input
    address: 208

  - name: LASER_OK
    description:
      short: Indicates if the laser detected any obstacles in its field.
      values:
        - "false": Obstacle detected.
        - "true": No obstacle detected or laser safety is off.
    type: bool/v1
    kind: input
    address: 209

  - name: EDM_STATUS
    description:
      short: Any relay malfunctions that could affect system safety.
      values:
        - "fault": Any relay malfunction.
        - "ok": All relays are working correctly.
    type: states/v1
    kind: input
    base_address: 2
    num_bits: 1
    states:
      - name: ok
        value: 0b0
      - name: fault
        value: 0b1

  - name: REED_ON
    description:
      short: Indicates if the reed switch is on, meaning the robot can charge with the pads.
      values:
        - "false": Charging station is not detected.
        - "true": Charging station is detected and robot can charge with the pads.
    type: bool/v1
    kind: input
    address: 240

  - name: CHARGING_PADS
    description:
      short: Indicates if the robot is charging.
      values:
        - "false": Robot is not charging through the pads.
        - "true": REED_ON is detected and robot is charging with charging station.
    type: bool/v1
    kind: input
    address: 241

  - name: CHARGE_LATCHING
    description:
      short: Switches charging pads to enable charging. Applied an OR operation with CHARGING_BOOLEAN.
      values:
        - "set": Enables charging pads.
        - "reset": Disables charging pads.
    type: set_reset/v1
    kind: output
    set_address: 9
    reset_address: 10
